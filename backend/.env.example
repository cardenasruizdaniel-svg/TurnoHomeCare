# Configuración del Servidor Backend DEATurnos
PORT=5000
NODE_ENV=production

# Base de Datos PostgreSQL (Producción en Render)
# En Render, asigne esta variable automáticamente al enlazar Render PostgreSQL Database
DATABASE_URL=postgres://usuario:password@localhost:5432/deaturnos

# Seguridad JWT
JWT_SECRET=deaturnos_super_secret_jwt_key_homecare_2026

# Habilitar Túnel Público (Opcional)
ENABLE_TUNNEL=false
